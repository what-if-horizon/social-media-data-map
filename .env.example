# Copy to .env and fill in. Loaded by the Makefile and src/config.py.
# Absolute path to the downloaded models
MODEL_DIR=
# Absolute path to the project data root
ROOT_DIR=
# Subfolder of ROOT_DIR with the processed data, e.g. ddd_processed
DATA_DIR=
DATA_SAMPLE=
# Sentence-transformers model (path or name) used to pick dissimilar smoke-sample paths (make smoke-select),
# e.g. $MODEL_DIR/sentence-transformers/all-MiniLM-L6-v2. Compute nodes have no internet, so download it first.
EMBEDDING_MODEL=
# Optional: defaults to $ROOT_DIR/ddd_annotation
# ANNOTATION_ROOT=
# Optional (defaults in src/config.py): human label column in the annotation files, smoke sample settings
# LABEL_COL=label
# SMOKE_K=5
# SMOKE_MAX_SIM=0.8
# SMOKE_POOL=2000
# SEED=42
